{
  "name": "MDeVinci",
  "short_name": "MDeVinci",
  "description": "A small offline Markdown editor: write, preview, and export as .md, .pdf or .html.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#EDE0C2",
  "theme_color": "#F1EEE7",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": { "text/markdown": [".md", ".markdown", ".mdown"] }
    }
  ]
}
